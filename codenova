<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CodeNova | Learn. Build. Master.</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>

<body>

<!-- ================= HEADER ================= -->

<header class="header">

    <div class="brand">
        <div class="brand-icon">&lt;/&gt;</div>

        <div>
            <h2>CodeNova</h2>
            <span>Learn • Build • Master</span>
        </div>
    </div>

    <nav class="nav">

        <a href="#home">Home</a>
        <a href="#courses">Courses</a>
        <a href="#playground">Playground</a>
        <a href="#challenges">Challenges</a>
        <a href="#about">About</a>

    </nav>

    <div class="header-actions">

        <button class="search-btn" onclick="openSearch()">
            🔍 Search
        </button>

        <button class="theme-btn" onclick="toggleTheme()">
            ☀
        </button>

        <button class="login-btn">
            Login
        </button>

    </div>

</header>


<!-- ================= HERO ================= -->

<section class="hero" id="home">

    <div class="hero-content">

        <div class="badge">
            🚀 The modern way to learn programming
        </div>

        <h1>
            Turn your
            <span>ideas</span>
            into code.
        </h1>

        <p>
            Learn web development and programming through
            interactive lessons, practical projects and
            real coding challenges.
        </p>

        <div class="hero-buttons">

            <button class="primary-btn" onclick="scrollToCourses()">
                Start Learning →
            </button>

            <button class="secondary-btn" onclick="scrollToPlayground()">
                Try Playground
            </button>

        </div>

        <div class="stats">

            <div>
                <strong>50+</strong>
                <span>Courses</span>
            </div>

            <div>
                <strong>500+</strong>
                <span>Lessons</span>
            </div>

            <div>
                <strong>1200+</strong>
                <span>Challenges</span>
            </div>

            <div>
                <strong>24K+</strong>
                <span>Learners</span>
            </div>

        </div>

    </div>


    <div class="hero-visual">

        <div class="floating-card card-one">
            ⚡ Fast Learning
        </div>

        <div class="floating-card card-two">
            🏆 +250 XP
        </div>

        <div class="code-window">

            <div class="window-top">

                <div class="window-buttons">
                    <i></i>
                    <i></i>
                    <i></i>
                </div>

                <span>app.js</span>

            </div>

            <div class="code">

                <span class="purple">const</span>
                <span class="blue">developer</span>
                <span>=</span>
                <span class="orange">"You"</span><br><br>

                <span class="purple">function</span>
                <span class="yellow">buildFuture</span>() {<br>

                &nbsp;&nbsp;
                <span class="purple">return</span>
                <span class="green">"Amazing"</span>;<br>

                }<br><br>

                <span class="yellow">console</span>.
                <span class="blue">log</span>(buildFuture());

            </div>

        </div>

    </div>

</section>


<!-- ================= COURSES ================= -->

<section class="courses-section" id="courses">

    <div class="section-heading">

        <div>
            <span class="section-label">LEARNING PATHS</span>

            <h2>Choose your path</h2>

            <p>
                Start from the basics or sharpen the skills
                you already have.
            </p>
        </div>

        <button class="outline-btn">
            View all courses →
        </button>

    </div>


    <div class="course-grid">


        <div class="course-card html-card">

            <div class="course-icon">
                &lt;/&gt;
            </div>

            <span class="level">BEGINNER</span>

            <h3>HTML Foundations</h3>

            <p>
                Build the structure of modern websites
                using semantic HTML.
            </p>

            <div class="progress">
                <div style="width:65%"></div>
            </div>

            <div class="course-bottom">
                <span>18 Lessons</span>
                <span>65%</span>
            </div>

            <button onclick="startCourse('HTML')">
                Continue →
            </button>

        </div>


        <div class="course-card css-card">

            <div class="course-icon">
                #
            </div>

            <span class="level">BEGINNER</span>

            <h3>CSS Design Lab</h3>

            <p>
                Master layouts, animations, responsive
                design and modern UI techniques.
            </p>

            <div class="progress">
                <div style="width:40%"></div>
            </div>

            <div class="course-bottom">
                <span>24 Lessons</span>
                <span>40%</span>
            </div>

            <button onclick="startCourse('CSS')">
                Continue →
            </button>

        </div>


        <div class="course-card js-card">

            <div class="course-icon">
                JS
            </div>

            <span class="level">INTERMEDIATE</span>

            <h3>JavaScript Core</h3>

            <p>
                Learn logic, functions, DOM manipulation,
                events and modern JavaScript.
            </p>

            <div class="progress">
                <div style="width:25%"></div>
            </div>

            <div class="course-bottom">
                <span>32 Lessons</span>
                <span>25%</span>
            </div>

            <button onclick="startCourse('JavaScript')">
                Start →
            </button>

        </div>


        <div class="course-card python-card">

            <div class="course-icon">
                Py
            </div>

            <span class="level">BEGINNER</span>

            <h3>Python Essentials</h3>

            <p>
                Learn Python syntax, data structures,
                functions and object-oriented programming.
            </p>

            <div class="progress">
                <div style="width:10%"></div>
            </div>

            <div class="course-bottom">
                <span>35 Lessons</span>
                <span>10%</span>
            </div>

            <button onclick="startCourse('Python')">
                Start →
            </button>

        </div>

    </div>

</section>


<!-- ================= PLAYGROUND ================= -->

<section class="playground-section" id="playground">

    <div class="playground-heading">

        <span class="section-label">CODE LAB</span>

        <h2>Build it. Run it. See it.</h2>

        <p>
            Experiment with HTML and CSS directly inside
            your browser.
        </p>

    </div>


    <div class="playground">

        <div class="editor-panel">

            <div class="editor-header">

                <span>EDITOR</span>

                <button onclick="runCode()">
                    ▶ Run
                </button>

            </div>

            <textarea id="codeEditor"><!DOCTYPE html>
<html>
<head>
<style>
body {
    font-family: Arial;
    text-align: center;
    padding: 40px;
}

h1 {
    color: #6d5dfc;
}

button {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    background: #6d5dfc;
    color: white;
}
</style>
</head>

<body>

<h1>Hello, CodeNova!</h1>

<p>My first interactive webpage.</p>

<button>Explore</button>

</body>
</html></textarea>

        </div>


        <div class="preview-panel">

            <div class="preview-header">
                LIVE PREVIEW
            </div>

            <iframe id="preview"></iframe>

        </div>

    </div>

</section>


<!-- ================= FEATURES ================= -->

<section class="features" id="challenges">

    <div class="section-heading centered">

        <span class="section-label">
            LEARN DIFFERENTLY
        </span>

        <h2>Everything you need to improve</h2>

        <p>
            CodeNova combines learning, practice and projects
            into one experience.
        </p>

    </div>


    <div class="feature-grid">

        <div class="feature">

            <div class="feature-icon">⚡</div>

            <h3>Interactive Learning</h3>

            <p>
                Don't just read code. Write it and see what
                happens instantly.
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">🧩</div>

            <h3>Coding Challenges</h3>

            <p>
                Test your knowledge with problems designed
                around real programming concepts.
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">🎯</div>

            <h3>Learning Paths</h3>

            <p>
                Follow structured paths instead of wondering
                what you should learn next.
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">🏆</div>

            <h3>Achievements</h3>

            <p>
                Earn XP, complete milestones and track your
                progress as you learn.
            </p>

        </div>

    </div>

</section>


<!-- ================= DASHBOARD ================= -->

<section class="dashboard">

    <div class="dashboard-content">

        <span class="section-label">
            YOUR PROGRESS
        </span>

        <h2>Keep your learning streak alive 🔥</h2>

        <p>
            Small progress every day can turn into powerful
            programming skills.
        </p>

        <button class="primary-btn">
            Open Dashboard →
        </button>

    </div>


    <div class="progress-card">

        <div class="profile-row">

            <div class="avatar">
                CN
            </div>

            <div>
                <strong>Learning Journey</strong>
                <span>Level 08 • Developer</span>
            </div>

        </div>


        <div class="xp">

            <div class="xp-info">
                <span>XP Progress</span>
                <strong>2,450 / 3,000</strong>
            </div>

            <div class="xp-bar">
                <div></div>
            </div>

        </div>


        <div class="streak">

            <div>
                <strong>🔥 12</strong>
                <span>Day streak</span>
            </div>

            <div>
                <strong>28</strong>
                <span>Lessons</span>
            </div>

            <div>
                <strong>14</strong>
                <span>Challenges</span>
            </div>

        </div>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer id="about">

    <div class="footer-main">

        <div class="footer-brand">

            <div class="brand">
                <div class="brand-icon">&lt;/&gt;</div>

                <div>
                    <h2>CodeNova</h2>
                    <span>Learn • Build • Master</span>
                </div>
            </div>

            <p>
                A modern learning environment for future
                developers and creative problem solvers.
            </p>

        </div>


        <div class="footer-column">

            <h4>Learn</h4>

            <a href="#courses">HTML</a>
            <a href="#courses">CSS</a>
            <a href="#courses">JavaScript</a>
            <a href="#courses">Python</a>

        </div>


        <div class="footer-column">

            <h4>Practice</h4>

            <a href="#playground">Playground</a>
            <a href="#challenges">Challenges</a>
            <a href="#">Projects</a>
            <a href="#">Quizzes</a>

        </div>


        <div class="footer-column">

            <h4>Community</h4>

            <a href="#">About</a>
            <a href="#">Contact</a>
            <a href="#">Feedback</a>
            <a href="#">Help Center</a>

        </div>

    </div>


    <div class="footer-bottom">

        <span>
            © 2026 CodeNova. Educational project.
        </span>

        <span>
            Built with HTML • CSS • JavaScript
        </span>

    </div>

</footer>


<!-- SEARCH MODAL -->

<div class="search-overlay" id="searchOverlay">

    <div class="search-box">

        <button class="close-search" onclick="closeSearch()">
            ×
        </button>

        <h2>What do you want to learn?</h2>

        <input
            type="text"
            id="searchInput"
            placeholder="Search HTML, CSS, JavaScript..."
            onkeyup="searchCourses()"
        >

        <div id="searchResults"></div>

    </div>

</div>


<script src="script.js"></script>

</body>
</html>
